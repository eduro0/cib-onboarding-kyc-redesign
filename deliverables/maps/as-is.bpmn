<!-- Generated by scripts/maps.py from model/as-is.yaml. Simulated example, not real bank data. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_as_is" targetNamespace="https://example.org/kyc-redesign" exporter="scripts/maps.py">
  <bpmn:collaboration id="collab_as_is">
    <bpmn:participant id="pool_as_is" name="As-Is: corporate onboarding and periodic KYC review" processRef="proc_as_is" />
  </bpmn:collaboration>
  <bpmn:process id="proc_as_is" isExecutable="false">
    <bpmn:laneSet id="lanes_as_is">
      <bpmn:lane id="lane_client" name="Corporate client">
        <bpmn:flowNodeRef>start_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_live</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_rm" name="Relationship manager">
        <bpmn:flowNodeRef>request_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ops" name="Onboarding &amp; KYC operations">
        <bpmn:flowNodeRef>prep_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>key_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ubo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clear_hits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_current</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_compliance" name="Financial crime compliance">
        <bpmn:flowNodeRef>edd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_edd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_systems" name="Systems">
        <bpmn:flowNodeRef>start_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_new" name="Client asks to open accounts">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_review" name="Review opened before its due date">
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_start_review" />
    </bpmn:startEvent>
    <bpmn:userTask id="prep_review" name="Pull the file and list what is out of date">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="request_docs" name="Email the client a generic KYC checklist">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="send_docs" name="Gather and send documents">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="check_pack" name="Check the pack is complete and current">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_complete" name="Complete?">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="chase" name="Chase the client for missing items">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="key_data" name="Re-key data into KYC and core systems">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ubo" name="Trace the ownership chain to beneficial owners">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="screen" name="Screen names: sanctions, PEP, adverse media">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="clear_hits" name="Clear screening hits one by one">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="rate" name="Assign the risk rating">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_risk" name="High risk or true match?">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="edd" name="Enhanced due diligence and compliance decision">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_edd" name="Approved?">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_declined" name="Declined or exited">
      <bpmn:incoming>flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="qc" name="Quality-check the KYC file">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_qc" name="QC passed?">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix_file" name="Fix the defects QC found">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_type" name="Case type?">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approve" name="Business signs off the relationship">
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="open_accounts" name="Open accounts and set up access">
      <bpmn:incoming>flow_26</bpmn:incoming>
      <bpmn:outgoing>flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_live" name="Accounts live">
      <bpmn:incoming>flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="update_file" name="Update the file, set the next review date">
      <bpmn:incoming>flow_25</bpmn:incoming>
      <bpmn:outgoing>flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_current" name="File current">
      <bpmn:incoming>flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_new" targetRef="request_docs" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="start_review" targetRef="prep_review" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="prep_review" targetRef="request_docs" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="request_docs" targetRef="send_docs" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="send_docs" targetRef="check_pack" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="check_pack" targetRef="gw_complete" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="gw_complete" targetRef="chase" name="No" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="chase" targetRef="send_docs" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="gw_complete" targetRef="key_data" name="Yes" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="key_data" targetRef="ubo" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="ubo" targetRef="screen" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="screen" targetRef="clear_hits" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="clear_hits" targetRef="rate" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="rate" targetRef="gw_risk" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="gw_risk" targetRef="edd" name="Yes" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="gw_risk" targetRef="qc" name="No" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="edd" targetRef="gw_edd" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="gw_edd" targetRef="qc" name="Yes" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="gw_edd" targetRef="end_declined" name="No" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="qc" targetRef="gw_qc" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="gw_qc" targetRef="fix_file" name="No" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="fix_file" targetRef="qc" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="gw_qc" targetRef="gw_type" name="Yes" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="gw_type" targetRef="approve" name="New client" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="gw_type" targetRef="update_file" name="Review" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="approve" targetRef="open_accounts" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="open_accounts" targetRef="end_live" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="update_file" targetRef="end_current" />
    <bpmn:textAnnotation id="note_P1"><bpmn:text>P1: Generic checklist by email: the client can't tell what applies to them</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P1" sourceRef="request_docs" targetRef="note_P1" />
    <bpmn:textAnnotation id="note_P2"><bpmn:text>P2: Packs arrive incomplete, so the client is chased in several rounds</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P2" sourceRef="chase" targetRef="note_P2" />
    <bpmn:textAnnotation id="note_P3"><bpmn:text>P3: The same data is typed into several systems by hand</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P3" sourceRef="key_data" targetRef="note_P3" />
    <bpmn:textAnnotation id="note_P4"><bpmn:text>P4: Ownership is traced through registries country by country</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P4" sourceRef="ubo" targetRef="note_P4" />
    <bpmn:textAnnotation id="note_P5"><bpmn:text>P5: Most screening hits are false positives, each cleared by hand</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P5" sourceRef="clear_hits" targetRef="note_P5" />
    <bpmn:textAnnotation id="note_P6"><bpmn:text>P6: Defects surface at the end, sending the file back</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P6" sourceRef="qc" targetRef="note_P6" />
    <bpmn:textAnnotation id="note_P7"><bpmn:text>P7: Each review restarts from scratch, even when nothing changed</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_P7" sourceRef="prep_review" targetRef="note_P7" />
    <bpmn:textAnnotation id="note_M1"><bpmn:text>M1: First request: is it clear what the bank needs from us?</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M1" sourceRef="request_docs" targetRef="note_M1" />
    <bpmn:textAnnotation id="note_M2"><bpmn:text>M2: Asked again: does the bank remember what we already sent?</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M2" sourceRef="chase" targetRef="note_M2" />
    <bpmn:textAnnotation id="note_M3"><bpmn:text>M3: Accounts live: how long did it take to start doing business?</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M3" sourceRef="end_live" targetRef="note_M3" />
  </bpmn:process>
