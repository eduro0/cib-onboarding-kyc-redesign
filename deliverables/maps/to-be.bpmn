<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by scripts/maps.py from model/to-be.yaml. Simulated example, not real bank data. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_to_be" targetNamespace="https://example.org/kyc-redesign" exporter="scripts/maps.py">
  <bpmn:collaboration id="collab_to_be">
    <bpmn:participant id="pool_to_be" name="To-Be: AI-first onboarding and periodic review, with human approval gates" processRef="proc_to_be" />
  </bpmn:collaboration>
  <bpmn:process id="proc_to_be" isExecutable="false">
    <bpmn:laneSet id="lanes_to_be">
      <bpmn:lane id="lane_client" name="Corporate client">
        <bpmn:flowNodeRef>start_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_live</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_rm" name="Relationship manager">
        <bpmn:flowNodeRef>fix_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ops" name="Onboarding &amp; KYC operations">
        <bpmn:flowNodeRef>approve_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide_hits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_rating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qc_signoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_qc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>update_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_current</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_compliance" name="Financial crime compliance">
        <bpmn:flowNodeRef>edd_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_edd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ai" name="AI assistant">
        <bpmn:flowNodeRef>prefill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>read_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edd_memo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preqc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_systems" name="Systems &amp; rules">
        <bpmn:flowNodeRef>start_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>open_accounts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_new" name="Client starts onboarding in the portal">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="start_review" name="Review opened before due date, or a trigger event">
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_start_review" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="prefill" name="AI: Pre-fill from registries and the file; list only what is missing">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="approve_request" name="Approve the client request, or confirm none is needed">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_ask" name="Anything to ask?">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="upload" name="Upload documents once in the portal">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="read_pack" name="AI: Read the pack: extract data and ownership, check it against the rules">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review_draft" name="Review the AI draft and its flags">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_complete" name="Complete?">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="screen" name="Screen names: sanctions, PEP, adverse media">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="triage" name="AI: Triage hits and explain each match">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="decide_hits" name="Decide each screening hit">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="rate" name="Rules propose the risk rating">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="confirm_rating" name="Confirm and record the rating">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_risk" name="High risk or true match?">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="edd_memo" name="AI: Draft the EDD memo with sources">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="edd_approve" name="Review the memo and decide">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_edd" name="Approved?">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_declined" name="Declined or exited">
      <bpmn:incoming>flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="preqc" name="AI: Pre-QC: run the file checks">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="qc_signoff" name="QC sign-off">
      <bpmn:documentation>Human approval gate: nothing passes without this decision.</bpmn:documentation>
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:incoming>flow_26</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_qc" name="QC passed?">
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
      <bpmn:outgoing>flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix_file" name="Fix the defects pre-QC and QC listed">
      <bpmn:incoming>flow_25</bpmn:incoming>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_type" name="Case type?">
      <bpmn:incoming>flow_27</bpmn:incoming>
      <bpmn:outgoing>flow_28</bpmn:outgoing>
      <bpmn:outgoing>flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approve" name="Business signs off the relationship">
      <bpmn:incoming>flow_28</bpmn:incoming>
      <bpmn:outgoing>flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="update_file" name="Record the outcome, set the next review date">
      <bpmn:incoming>flow_29</bpmn:incoming>
      <bpmn:outgoing>flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_current" name="File current">
      <bpmn:incoming>flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="open_accounts" name="Open accounts and set up access">
      <bpmn:incoming>flow_30</bpmn:incoming>
      <bpmn:outgoing>flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_live" name="Accounts live">
      <bpmn:incoming>flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_new" targetRef="prefill" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="start_review" targetRef="prefill" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="prefill" targetRef="approve_request" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="approve_request" targetRef="gw_ask" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="gw_ask" targetRef="upload" name="Yes" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="gw_ask" targetRef="screen" name="No: nothing missing" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="upload" targetRef="read_pack" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="read_pack" targetRef="review_draft" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="review_draft" targetRef="gw_complete" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="gw_complete" targetRef="approve_request" name="No: one follow-up" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="gw_complete" targetRef="screen" name="Yes" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="screen" targetRef="triage" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="triage" targetRef="decide_hits" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="decide_hits" targetRef="rate" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="rate" targetRef="confirm_rating" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="confirm_rating" targetRef="gw_risk" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="gw_risk" targetRef="edd_memo" name="Yes" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="gw_risk" targetRef="preqc" name="No" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="edd_memo" targetRef="edd_approve" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="edd_approve" targetRef="gw_edd" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="gw_edd" targetRef="preqc" name="Yes" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="gw_edd" targetRef="end_declined" name="No" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="preqc" targetRef="qc_signoff" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="qc_signoff" targetRef="gw_qc" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="gw_qc" targetRef="fix_file" name="No" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="fix_file" targetRef="qc_signoff" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="gw_qc" targetRef="gw_type" name="Yes" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="gw_type" targetRef="approve" name="New client" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="gw_type" targetRef="update_file" name="Review" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="approve" targetRef="open_accounts" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="open_accounts" targetRef="end_live" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="update_file" targetRef="end_current" />
    <bpmn:textAnnotation id="note_M1"><bpmn:text>M1: First request: one tailored list, one upload</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M1" sourceRef="upload" targetRef="note_M1" />
    <bpmn:textAnnotation id="note_M2"><bpmn:text>M2: Asked again: at most one follow-up, every item at once, and none on a review with nothing missing</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M2" sourceRef="upload" targetRef="note_M2" />
    <bpmn:textAnnotation id="note_M3"><bpmn:text>M3: Accounts live: days sooner, with fewer asks</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_M3" sourceRef="end_live" targetRef="note_M3" />
    <bpmn:textAnnotation id="note_fix_prefill"><bpmn:text>Fixes P1, P7</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_fix_prefill" sourceRef="prefill" targetRef="note_fix_prefill" />
    <bpmn:textAnnotation id="note_fix_approve_request"><bpmn:text>Fixes P2</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_fix_approve_request" sourceRef="approve_request" targetRef="note_fix_approve_request" />
    <bpmn:textAnnotation id="note_fix_read_pack"><bpmn:text>Fixes P3, P4</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_fix_read_pack" sourceRef="read_pack" targetRef="note_fix_read_pack" />
    <bpmn:textAnnotation id="note_fix_triage"><bpmn:text>Fixes P5</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_fix_triage" sourceRef="triage" targetRef="note_fix_triage" />
    <bpmn:textAnnotation id="note_fix_preqc"><bpmn:text>Fixes P6</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_fix_preqc" sourceRef="preqc" targetRef="note_fix_preqc" />
  </bpmn:process>
